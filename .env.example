# --- Required ---

# libSQL/Turso database. Local dev: "file:local.db".
# Production (Turso): "libsql://your-db-name.turso.io" + auth token.
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Secret for signing session cookies. Generate with (PowerShell or bash):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Public URL of the deployment (used for Stripe redirect URLs).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated emails allowed to view the /admin metrics page.
ADMIN_EMAILS=you@your-domain.com

# Shown as the "get in touch" address on the pricing page. Leave blank and
# the link is hidden rather than published as an address that bounces.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Google sign-in (optional) ---
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client
# (type: Web application). Authorised redirect URI must be exactly:
#   https://your-domain/api/auth/google/callback
# Leave blank and the "Continue with Google" buttons simply don't appear.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (optional) ---
# With no key set, verification/reset emails are logged to the server console
# instead of being sent — handy in development.
RESEND_API_KEY=
EMAIL_FROM="OGsmith <hello@your-domain.com>"

# --- Stripe (optional until you enable billing) ---
# Create two recurring prices (Pro $9/mo, Scale $29/mo) in the Stripe
# dashboard and paste their price IDs here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_SCALE=

# Set to "true" only AFTER enabling Stripe Tax in the Stripe dashboard and
# adding your Spanish VAT registration. Turning it on beforehand makes
# checkout fail. When on, VAT is added on top of the price and EU business
# customers can enter a VAT number for reverse charge.
STRIPE_TAX_ENABLED=
