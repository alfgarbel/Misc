{
  "name": "ogsmith-mcp",
  "version": "0.1.0",
  "description": "MCP server for OGsmith: render, preview and save Open Graph social cards from Claude or any MCP client.",
  "mcpName": "io.github.alfgarbel/ogsmith",
  "license": "MIT",
  "homepage": "https://ogsmith.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alfgarbel/Misc.git",
    "directory": "packages/mcp"
  },
  "keywords": ["mcp", "open-graph", "og-image", "social-card", "claude"],
  "type": "module",
  "bin": {
    "ogsmith-mcp": "dist/index.js"
  },
  "files": ["dist", "README.md"],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist/index.js --external:@modelcontextprotocol/sdk --external:zod",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.4.3"
  }
}
