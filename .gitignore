# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which documents what the others must contain and
# carries no secrets. It was being ignored, so a fresh clone had no record
# of which variables the app needs.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local databases
local.db
*.db
*.db-journal

# env
.env

# Prospecting output: drafts addressed to real people, plus rendered cards
# of their pages. Review locally, never commit.
/outbound/
